---
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<footer class="site-footer">
  <div class="wrapper">
    <div class="footer-col-wrapper">
      <div class="footer-col footer-col-1">
        <ul class="contact-list">
          <li>
            <a href={`${base}contact`}>Contact</a>
          </li>
          <li>
            <a href={`${base}disclaimer`}>Disclaimer</a>
          </li>
          <li>
            <a href="https://github.com/gerardoramirez" target="_blank" rel="noopener noreferrer">GitHub</a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/gerardo-ramirez-09/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </li>
          <li>
            <a href="https://x.com/lapatrialibre" target="_blank" rel="noopener noreferrer">Twitter / X</a>
          </li>
        </ul>
      </div>
      <div class="footer-col footer-col-2">
        <p>
          I transform complex technical and human problems into practical software experiences.
        </p>
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} Gerardo Ramirez
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) 0;
    margin-top: var(--space-2xl);
  }

  .footer-col-wrapper {
    display: grid;
    grid-template-columns: 0.8fr 1.4fr;
    gap: var(--space-lg);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-list li + li {
    margin-top: 0.35rem;
  }

  .contact-list a {
    color: var(--color-text-muted);
  }

  .contact-list a:hover {
    color: var(--color-text);
  }

  .footer-col p {
    margin-bottom: 0.75rem;
  }

  .footer-copy {
    margin-bottom: 0;
    font-size: 0.875rem;
  }

  @media (max-width: 600px) {
    .footer-col-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
