---
interface Props {
  title?: string;
  subtitle?: string;
  cta_text?: string;
  cta_href?: string;
  background?: string;
  dark?: boolean;
}

const { 
  title, 
  subtitle,
  cta_text,
  cta_href = '/',
  background = 'linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%)',
  dark = false
} = Astro.props;
---

<section class="hero" style={`background: ${background}`} class:list={{ dark }}>
  <div class="hero-content">
    {title && <h1>{title}</h1>}
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    <slot />
    {cta_text && cta_href && (
      <div class="hero-ctas">
        <a href={cta_href} class="btn-primary">{cta_text}</a>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }
  
  .hero-content {
    max-width: 900px;
    text-align: center;
  }
  
  .hero h1 {
    margin-bottom: var(--space-md);
    font-size: 3rem;
  }
  
  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    line-height: 1.6;
  }
  
  .hero-ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    margin-top: var(--space-xl);
  }
  
  .hero.dark {
    background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
    color: white;
  }
  
  .hero.dark :global(a) {
    color: var(--color-accent);
  }
  
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-lg) var(--space-md);
    }
    
    .hero h1 {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1.1rem;
    }
  }
</style>
