---
interface Props {
  title?: string;
  subtitle?: string;
  cta_text?: string;
  cta_href?: string;
  background?: string;
  dark?: boolean;
}

const { 
  title, 
  subtitle,
  cta_text,
  cta_href = '/',
  background,
  dark = false
} = Astro.props;
---

<section
  class:list={['hero', { dark }]}
  style={background ? `background: ${background}` : undefined}
>
  <div class="hero-content wrapper">
    {title && <h1>{title}</h1>}
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    <slot />
    {cta_text && cta_href && (
      <div class="hero-ctas">
        <a href={cta_href} class="btn-primary">{cta_text}</a>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    padding: var(--space-xl) 0 var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    animation: fade-rise 0.7s ease both;
  }
  
  .hero-content {
    max-width: var(--content-width);
  }
  
  .hero h1 {
    margin-bottom: var(--space-sm);
  }
  
  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    max-width: 38em;
  }
  
  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }
  
  .hero.dark {
    background: linear-gradient(180deg, #1a1a1a 0%, #111111 100%);
    color: #fdfdfd;
  }
  
  .hero.dark :global(a) {
    color: #9db4ff;
  }
  
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-lg) 0;
    }
  }
</style>
