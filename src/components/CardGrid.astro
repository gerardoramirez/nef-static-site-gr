---
interface Props {
  columns?: 1 | 2 | 3 | 4;
  gap?: string;
}

const { columns = 3, gap = 'var(--space-lg)' } = Astro.props;
---

<div class="card-grid" style={`--grid-columns: ${columns}; --grid-gap: ${gap}`}>
  <slot />
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grid-gap);
    margin: var(--space-lg) 0;
  }

  @media (min-width: 900px) {
    .card-grid {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }
  }
</style>
