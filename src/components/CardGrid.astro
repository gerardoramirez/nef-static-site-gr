---
interface Props {
  columns?: 1 | 2 | 3 | 4;
  gap?: string;
}

const { columns = 3, gap = 'var(--space-lg)' } = Astro.props;
---

<div class="card-grid" style={`--grid-columns: ${columns}; --grid-gap: ${gap}`}>
  <slot />
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), 1fr);
    gap: var(--grid-gap);
    margin: var(--space-xl) 0;
  }
  
  @media (max-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
