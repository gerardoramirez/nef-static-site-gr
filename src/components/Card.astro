---
interface Props {
  title: string;
  description?: string;
  href?: string;
  image?: string;
  tags?: string[];
  metadata?: {
    date?: Date;
    role?: string;
    status?: string;
  };
}

const { title, description, href = '#', image, tags = [], metadata } = Astro.props;
---

<article class="card" class:list={{ "card--with-image": image }}>
  {image && (
    <div class="card-image">
      <img src={image} alt={title} />
    </div>
  )}
  
  <div class="card-content">
    <h3 class="card-title">
      <a href={href}>{title}</a>
    </h3>
    
    {description && (
      <p class="card-description">{description}</p>
    )}
    
    {metadata && (
      <div class="card-metadata">
        {metadata.date && (
          <span class="metadata-item">
            {new Date(metadata.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
          </span>
        )}
        {metadata.role && (
          <span class="metadata-item">{metadata.role}</span>
        )}
        {metadata.status && (
          <span class="metadata-item status" class:list={[`status--${metadata.status}`]}>
            {metadata.status}
          </span>
        )}
      </div>
    )}
    
    {tags && tags.length > 0 && (
      <div class="card-tags">
        {tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
    
    {href && (
      <a href={href} class="card-link">Read more →</a>
    )}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    overflow: hidden;
    transition: border-color 0.2s ease;
    height: 100%;
    padding-bottom: var(--space-md);
  }
  
  .card:hover {
    border-bottom-color: var(--color-border-light);
  }
  
  .card-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background-color: var(--color-surface);
    margin-bottom: var(--space-sm);
  }
  
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .card-content {
    flex: 1;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  
  .card-title {
    margin: 0 0 0.35rem 0;
    font-size: 1.35rem;
    font-weight: 400;
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .card-title a:visited {
    color: var(--color-text);
  }

  .card-title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .card-description {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 var(--space-sm) 0;
    flex-grow: 1;
  }
  
  .card-metadata {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  
  .metadata-item {
    display: inline-block;
  }
  
  .status {
    text-transform: capitalize;
  }
  
  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
  }
  
  .tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-text-muted);
    text-transform: lowercase;
  }
  
  .card-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 400;
  }
  
  .card-link:hover {
    text-decoration: underline;
  }
</style>
