---
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;

const getPathWithoutBase = (path: string) => {
  if (baseUrl === '/') {
    return path;
  }
  const baseWithoutSlash = baseUrl.replace(/\/$/, '');
  if (baseWithoutSlash && path.startsWith(baseWithoutSlash)) {
    const withoutBase = path.slice(baseWithoutSlash.length) || '/';
    return withoutBase;
  }
  return path;
};

const pathForComparison = getPathWithoutBase(currentPath);

const links = [
  { href: `${base}work`, label: 'Work', match: '/work' },
  { href: `${base}writing`, label: 'Writing', match: '/writing' },
  { href: `${base}products`, label: 'Products', match: '/products' },
  { href: `${base}speaking`, label: 'Speaking', match: '/speaking' },
  { href: `${base}contact`, label: 'Contact', match: '/contact' },
];
---

<header class="site-header">
  <div class="wrapper header-inner">
    <a href={base} class="site-title">Gerardo Ramirez</a>
    <nav class="site-nav" aria-label="Primary">
      <input type="checkbox" id="nav-trigger" class="nav-trigger" />
      <label for="nav-trigger" class="menu-toggle">
        <span class="menu-icon" aria-hidden="true">
          <svg viewBox="0 0 18 15" width="18" height="15">
            <path fill="currentColor" d="M18,1.484c0,0.82-0.665,1.484-1.484,1.484H1.484C0.665,2.969,0,2.304,0,1.484l0,0C0,0.665,0.665,0,1.484,0 h15.031C17.335,0,18,0.665,18,1.484L18,1.484z"/>
            <path fill="currentColor" d="M18,7.516C18,8.335,17.335,9,16.516,9H1.484C0.665,9,0,8.335,0,7.516l0,0c0-0.82,0.665-1.484,1.484-1.484 h15.031C17.335,6.031,18,6.696,18,7.516L18,7.516z"/>
            <path fill="currentColor" d="M18,13.516C18,14.335,17.335,15,16.516,15H1.484C0.665,15,0,14.335,0,13.516l0,0 c0-0.82,0.665-1.484,1.484-1.484h15.031C17.335,12.031,18,12.696,18,13.516L18,13.516z"/>
          </svg>
        </span>
        <span class="visually-hidden">Menu</span>
      </label>
      <div class="trigger">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['page-link', { active: pathForComparison.startsWith(link.match) }]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    min-height: 56px;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(253, 253, 253, 0.92);
    backdrop-filter: blur(8px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
  }

  .site-title {
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 54px;
    color: var(--color-secondary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .site-title:visited,
  .site-title:hover {
    color: var(--color-secondary);
    text-decoration: none;
  }

  .site-nav {
    line-height: 54px;
  }

  .nav-trigger {
    display: none;
  }

  .menu-toggle {
    display: none;
  }

  .trigger {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .page-link {
    color: var(--color-text);
    line-height: 1.5;
    font-size: 1rem;
  }

  .page-link:visited {
    color: var(--color-text);
  }

  .page-link:hover,
  .page-link.active {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 600px) {
    .site-nav {
      position: absolute;
      top: 9px;
      right: 15px;
      background-color: var(--color-background);
      border: 1px solid var(--color-border);
      border-radius: 5px;
      text-align: right;
      line-height: 1.5;
    }

    .menu-toggle {
      display: block;
      float: right;
      width: 36px;
      height: 36px;
      cursor: pointer;
      color: var(--color-secondary);
    }

    .menu-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
    }

    .trigger {
      clear: both;
      display: none;
      flex-direction: column;
      align-items: flex-end;
      gap: 0;
      padding-bottom: 5px;
    }

    .nav-trigger:checked ~ .trigger {
      display: flex;
    }

    .page-link {
      display: block;
      padding: 5px 10px;
      margin-left: 20px;
    }
  }
</style>
