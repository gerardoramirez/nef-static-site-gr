---
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;

const getPathWithoutBase = (path: string) => {
  if (baseUrl === '/') {
    return path;
  }
  const baseWithoutSlash = baseUrl.replace(/\/$/, '');
  if (baseWithoutSlash && path.startsWith(baseWithoutSlash)) {
    const withoutBase = path.slice(baseWithoutSlash.length) || '/';
    return withoutBase;
  }
  return path;
};

const pathForComparison = getPathWithoutBase(currentPath);
---

<nav class="navigation">
  <div class="nav-container">
    <a href={base} class="logo">Gerardo Ramirez</a>
    <ul class="nav-links">
      <li><a href={base} class={pathForComparison === '/' ? 'active' : ''}>Home</a></li>
      <li><a href={`${base}work`} class={pathForComparison.startsWith('/work') ? 'active' : ''}>Work</a></li>
      <li><a href={`${base}products`} class={pathForComparison.startsWith('/products') ? 'active' : ''}>Products</a></li>
      <li><a href={`${base}writing`} class={pathForComparison.startsWith('/writing') ? 'active' : ''}>Writing</a></li>
      <li><a href={`${base}speaking`} class={pathForComparison.startsWith('/speaking') ? 'active' : ''}>Speaking</a></li>
    </ul>
    <a href={`${base}contact`} class="nav-cta">Get in touch</a>
  </div>
</nav>

<style>
  .navigation {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    height: 80px;
  }

  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-links a.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .nav-cta {
    background-color: var(--color-accent);
    color: white;
    padding: 0.5rem 1.25rem;
    border-radius: 0.375rem;
    font-weight: 500;
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background-color: #0284c7;
  }

  @media (max-width: 1024px) {
    .nav-container {
      padding: 1rem;
    }

    .nav-links {
      gap: 1.5rem;
    }

    .logo {
      font-size: 1.1rem;
    }

    .nav-cta {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 1rem;
      font-size: 0.9rem;
    }

    .logo {
      font-size: 1rem;
    }
  }
</style>

