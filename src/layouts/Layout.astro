---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { 
  title = 'Gerardo Ramirez - Solutions Engineer, Architect, Builder',
  description = 'Building software that helps people perform, remember, and connect',
  image = '/og-image.png',
  canonical = 'https://gerardoramirez.info'
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
		
		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		
		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:type" content="website" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
	</head>
	<body>
		<slot />
		<a
			href="https://github.com/gerardoramirez/nef-static-site-gr"
			target="_blank"
			rel="noopener noreferrer"
			class="repo-link"
			aria-label="View source on GitHub"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
			</svg>
			<span>Source</span>
		</a>
	</body>
</html>

<style is:global>
	:root {
		--color-primary: #111111;
		--color-secondary: #424242;
		--color-accent: #4d74eb;
		--color-accent-hover: #111111;
		--color-accent-visited: #1337a6;
		--color-text: #111111;
		--color-text-muted: #828282;
		--color-text-light: #9a9a9a;
		--color-background: #fdfdfd;
		--color-surface: #f7f5f1;
		--color-surface-alt: #f0eee8;
		--color-border: #e8e8e8;
		--color-border-light: #d8d8d8;
		
		--font-family: "Lora", Georgia, "Times New Roman", serif;
		--font-mono: "Monaco", "Courier New", monospace;
		
		--space-xs: 0.5rem;
		--space-sm: 0.9375rem;
		--space-md: 1.5rem;
		--space-lg: 1.875rem;
		--space-xl: 2.5rem;
		--space-2xl: 3.75rem;
		
		--content-width: 785px;
		--page-pad: 15px;
		
		--bp-mobile: 320px;
		--bp-tablet: 768px;
		--bp-desktop: 1024px;
		--bp-wide: 1440px;
	}
	
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		font-family: var(--font-family);
		font-weight: 400;
		line-height: 1.5;
		color: var(--color-text);
		background-color: var(--color-background);
		background-image:
			radial-gradient(ellipse 120% 80% at 0% 0%, rgba(77, 116, 235, 0.04), transparent 55%),
			radial-gradient(ellipse 90% 60% at 100% 10%, rgba(17, 17, 17, 0.03), transparent 50%),
			linear-gradient(180deg, #faf8f4 0%, #fdfdfd 28%, #fdfdfd 100%);
		background-attachment: fixed;
		font-size: 16px;
		-webkit-font-smoothing: antialiased;
		font-kerning: normal;
		font-feature-settings: "kern" 1;
	}

	* {
		box-sizing: border-box;
	}
	
	h1, h2, h3, h4, h5, h6 {
		line-height: 1.25;
		margin-top: 0;
		margin-bottom: var(--space-sm);
		letter-spacing: -0.01em;
		font-weight: 400;
	}
	
	h1 {
		font-size: 2.625rem;
		letter-spacing: -1px;
		line-height: 1.05;
	}
	
	h2 {
		font-size: 2rem;
	}
	
	h3 {
		font-size: 1.625rem;
	}
	
	h4 {
		font-size: 1.25rem;
	}
	
	p {
		margin: 0 0 var(--space-sm);
		line-height: 1.5;
	}
	
	a {
		color: var(--color-accent);
		text-decoration: none;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}

	a:visited {
		color: var(--color-accent-visited);
	}
	
	a:hover {
		color: var(--color-accent-hover);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	
	button, .btn {
		font-family: var(--font-family);
		border: 1px solid var(--color-border);
		border-radius: 3px;
		cursor: pointer;
		transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
		font-weight: 400;
		padding: 0.5rem 1rem;
		font-size: 1rem;
		background: transparent;
		color: var(--color-text);
	}
	
	.btn-primary {
		background-color: var(--color-accent);
		border-color: var(--color-accent);
		color: white;
	}
	
	.btn-primary:hover {
		background-color: #3d61d4;
		border-color: #3d61d4;
		color: white;
		text-decoration: none;
	}
	
	.btn-secondary {
		background-color: transparent;
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}
	
	.btn-secondary:hover {
		background-color: var(--color-surface);
		border-color: var(--color-border-light);
		text-decoration: none;
	}

	.wrapper {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 var(--page-pad);
	}

	@keyframes fade-rise {
		from {
			opacity: 0;
			transform: translateY(0.6rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 800px) {
		h1 {
			font-size: 2.25rem;
		}

		h2 {
			font-size: 1.75rem;
		}

		h3 {
			font-size: 1.375rem;
		}
	}

	.repo-link {
		position: fixed;
		bottom: 1.25rem;
		right: 1.25rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.75rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 6px;
		color: var(--color-text-muted);
		font-family: var(--font-family);
		font-size: 0.8125rem;
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
		z-index: 100;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
	}

	.repo-link:hover {
		background: var(--color-surface-alt);
		border-color: var(--color-border-light);
		color: var(--color-text);
		text-decoration: none;
	}

	.repo-link:visited {
		color: var(--color-text-muted);
	}

	@media (max-width: 600px) {
		.repo-link span {
			display: none;
		}

		.repo-link {
			padding: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
