---
import Layout from './Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Metadata from '../components/Metadata.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  date?: Date;
  author?: string;
  tags?: string[];
}

const { title, description, image, canonical, date, author = 'Gerardo Ramirez', tags = [] } = Astro.props;
---

<Layout {title} {description} {image} {canonical}>
  <Navigation />
  <main class="page-content">
    <article class="article-container wrapper">
      <header class="article-header">
        <h1>{title}</h1>
        {description && <p class="article-description">{description}</p>}
        {(date || author || tags.length > 0) && (
          <Metadata {date} {author} {tags} />
        )}
      </header>
      
      <div class="article-content">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .page-content {
    padding: var(--space-lg) 0 var(--space-xl);
  }

  .article-container {
    min-height: calc(100vh - 56px - 180px);
    animation: fade-rise 0.7s ease both;
  }
  
  .article-header {
    margin-bottom: var(--space-xl);
  }
  
  .article-header h1 {
    margin-bottom: var(--space-sm);
  }
  
  .article-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    max-width: 38em;
  }
  
  .article-content {
    font-size: 1rem;
    line-height: 1.5;
    animation: fade-rise 0.75s ease 0.08s both;
  }
  
  .article-content :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    font-size: 1.75rem;
  }
  
  .article-content :global(h3) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: 1.375rem;
  }
  
  .article-content :global(p) {
    margin-bottom: 1rem;
    max-width: 40em;
  }
  
  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    max-width: 40em;
  }
  
  .article-content :global(li) {
    margin-bottom: 0.4rem;
  }
  
  .article-content :global(code) {
    background-color: #eef;
    border: 1px solid var(--color-border);
    padding: 1px 5px;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  
  .article-content :global(pre) {
    background-color: #eef;
    border: 1px solid var(--color-border);
    padding: 8px 12px;
    border-radius: 3px;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  
  .article-content :global(pre code) {
    background-color: transparent;
    border: 0;
    padding: 0;
  }
  
  .article-content :global(blockquote) {
    border-left: 4px solid var(--color-border);
    padding-left: var(--space-sm);
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-style: italic;
    font-size: 1.125rem;
    letter-spacing: -0.5px;
    max-width: 40em;
  }

  @media (max-width: 800px) {
    .article-content :global(h2) {
      font-size: 1.5rem;
    }
  }
</style>
