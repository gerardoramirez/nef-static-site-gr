---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('products')).filter((item) => !item.data.draft);
const featuredProduct = items.find((item) => item.slug === 'human-truth-driven-design');
const otherProducts = items.filter((item) => item.slug !== featuredProduct?.slug);

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<Layout
  title="Products & Frameworks | Gerardo Ramirez"
  description="Products, experiments, and frameworks built by Gerardo Ramirez."
  canonical={`${base}products`}
>
  <Navigation />
  <main class="page-content">
    <div class="wrapper products-page">
      <header class="page-header">
        <p class="eyebrow">Ideas made tangible</p>
        <h1>Products &amp; frameworks</h1>
        <p class="page-intro">
          A collection of products, experiments, and ways of thinking shaped by real
          people and the problems worth solving.
        </p>
      </header>

      {featuredProduct && (
        <section class="featured" aria-labelledby="featured-title">
          <div class="featured-copy">
            <p class="eyebrow">Featured framework</p>
            <h2 id="featured-title">{featuredProduct.data.title}</h2>
            <p class="featured-tagline">{featuredProduct.data.tagline}</p>
            <p class="featured-description">{featuredProduct.data.description}</p>
            <a class="featured-link" href={featuredProduct.data.url || `${base}products/${featuredProduct.slug}`}>
              Explore the framework <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="featured-mark" aria-hidden="true">
            <span>HT</span>
            <span class="mark-caption">People first.<br />Technology with purpose.</span>
          </div>
        </section>
      )}

      {otherProducts.length > 0 && (
        <section class="collection" aria-labelledby="collection-title">
          <div class="section-heading">
            <p class="eyebrow">More from the workshop</p>
            <h2 id="collection-title">Other projects</h2>
          </div>
          <ul class="product-grid">
            {otherProducts.map((item) => (
              <li class="product-card">
                <div class="card-topline">
                  <span class="status">{item.data.status || 'Project'}</span>
                  <span class="card-arrow" aria-hidden="true">↗</span>
                </div>
                <h3>
                  <a href={item.data.url || `${base}products/${item.slug}`}>{item.data.title}</a>
                </h3>
                {(item.data.tagline || item.data.description) && (
                  <p>{item.data.tagline || item.data.description}</p>
                )}
                {item.data.tags.length > 0 && (
                  <ul class="tags" aria-label={`${item.data.title} topics`}>
                    {item.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-content {
    padding: clamp(3rem, 8vw, 6.5rem) 0 var(--space-xl);
  }

  .products-page {
    animation: fade-rise 0.7s ease both;
  }

  .page-header {
    margin-bottom: clamp(2.5rem, 7vw, 5rem);
  }

  .eyebrow {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    letter-spacing: -0.055em;
    margin-bottom: 1.25rem;
  }

  .page-intro {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    max-width: 39em;
  }

  .featured {
    align-items: center;
    background: #171b27;
    border-radius: 8px;
    color: #fff;
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 1.2fr) minmax(13rem, 0.8fr);
    margin-bottom: clamp(4rem, 10vw, 7rem);
    overflow: hidden;
    padding: clamp(2rem, 6vw, 4.5rem);
    position: relative;
  }

  .featured::after {
    background: radial-gradient(circle, rgba(97, 132, 255, 0.28), transparent 68%);
    content: '';
    height: 26rem;
    pointer-events: none;
    position: absolute;
    right: -10rem;
    top: -12rem;
    width: 26rem;
  }

  .featured-copy,
  .featured-mark {
    position: relative;
    z-index: 1;
  }

  .featured .eyebrow {
    color: #aabaff;
  }

  .featured h2 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
  }

  .featured-tagline {
    color: #d4d8e4;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }

  .featured-description {
    color: #b8bece;
    max-width: 38em;
  }

  .featured-link {
    align-items: center;
    background: #fff;
    border-radius: 4px;
    color: #171b27;
    display: inline-flex;
    font-size: 0.95rem;
    font-weight: 600;
    gap: 0.65rem;
    margin-top: 0.8rem;
    padding: 0.8rem 1rem;
  }

  .featured-link:visited,
  .featured-link:hover {
    color: #171b27;
    text-decoration: none;
  }

  .featured-link:hover {
    background: #e6eaff;
  }

  .featured-mark {
    align-items: center;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-self: center;
    max-width: 18rem;
    text-align: center;
    width: 100%;
  }

  .featured-mark > span:first-child {
    color: #dce3ff;
    font-size: clamp(4rem, 10vw, 7rem);
    letter-spacing: -0.09em;
    line-height: 1;
  }

  .mark-caption {
    color: #aeb7d0;
    font-size: 0.8rem;
    line-height: 1.5;
    margin-top: 0.75rem;
  }

  .collection {
    margin-bottom: var(--space-2xl);
  }

  .section-heading {
    margin-bottom: var(--space-lg);
  }

  .section-heading h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    letter-spacing: -0.04em;
    margin: 0;
  }

  .product-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product-card {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    min-height: 14rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-2px);
  }

  .card-topline {
    align-items: center;
    color: var(--color-text-muted);
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    justify-content: space-between;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .card-arrow {
    color: var(--color-accent);
    font-size: 1rem;
  }

  .product-card h3 {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .product-card h3 a {
    color: var(--color-text);
  }

  .product-card h3 a:visited {
    color: var(--color-text);
  }

  .product-card h3 a:hover {
    color: var(--color-accent);
  }

  .product-card > p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    max-width: 38em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: auto 0 0;
    padding: 0;
  }

  .tags li {
    background: var(--color-surface);
    border-radius: 99px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
  }

  @media (max-width: 650px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured-mark {
      max-width: 12rem;
      grid-row: 1;
    }

    .product-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card {
      transition: none;
    }
  }
</style>
