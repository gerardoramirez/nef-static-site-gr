---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('products')).filter((item) => !item.data.draft);
const featuredProduct = items.find((item) => item.slug === 'human-truth-driven-design');
const otherProducts = items.filter((item) => item.slug !== featuredProduct?.slug);

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<Layout
  title="Products & Frameworks | Gerardo Ramirez"
  description="Products, experiments, and frameworks built by Gerardo Ramirez."
  canonical={`${base}products`}
>
  <Navigation />
  <main class="page-content">
    <div class="wrapper products-page">
      <header class="page-header">
        <h1>Products &amp; frameworks</h1>
        <p>
          Software experiments and product frameworks built around how people work,
          collaborate, and make decisions.
        </p>
      </header>

      {featuredProduct && (
        <section class="featured" aria-labelledby="featured-title">
          <h2 id="featured-title">
            <a href={featuredProduct.data.url || `${base}products/${featuredProduct.slug}`}>
              {featuredProduct.data.title}
            </a>
          </h2>
          <div class="featured-copy">
            <p class="featured-tagline">{featuredProduct.data.tagline}</p>
            <p>{featuredProduct.data.description}</p>
            <a class="project-link" href={featuredProduct.data.url || `${base}products/${featuredProduct.slug}`}>
              Visit Human Truth Driven Design <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      )}

      {otherProducts.length > 0 && (
        <section class="collection" aria-labelledby="collection-title">
          <h2 id="collection-title">Other projects</h2>
          <ul class="project-list">
            {otherProducts.map((item) => (
              <li class="project-row">
                <h3>
                  <a href={item.data.url || `${base}products/${item.slug}`}>{item.data.title}</a>
                </h3>
                <p>{item.data.tagline || item.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-content {
    padding: clamp(3.5rem, 9vw, 7rem) 0 var(--space-xl);
  }

  .products-page {
    animation: none;
  }

  .page-header {
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .page-header h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.7;
    margin: 0;
    max-width: 46em;
  }

  .featured {
    border-bottom: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.2fr);
    padding: clamp(2rem, 5vw, 3.5rem) 0;
  }

  .featured h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .featured h2 a,
  .project-row h3 a {
    color: var(--color-text);
  }

  .featured h2 a:visited,
  .project-row h3 a:visited {
    color: var(--color-text);
  }

  .featured-copy p {
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 46em;
  }

  .featured-copy .featured-tagline {
    color: var(--color-text);
    font-size: 1.25rem;
    margin-top: 0;
  }

  .project-link {
    display: inline-block;
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .collection {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .collection > h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-row {
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.2fr);
    padding: 1.5rem 0;
  }

  .project-row h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .project-row p {
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 46em;
  }

  @media (max-width: 650px) {
    .featured,
    .project-row {
      gap: 1rem;
      grid-template-columns: 1fr;
    }

    .featured {
      padding: 1.75rem 0;
    }
  }
</style>
