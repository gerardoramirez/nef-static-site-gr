---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Metadata from '../../components/Metadata.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('neat-things');
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<Layout
  title={`${item.data.title} | Gerardo Ramirez`}
  description={item.data.description}
  image={item.data.image}
  canonical={`${base}neat-things/${item.slug}`}
>
  <Navigation />
  <main class="page-content">
    <article class="article-container wrapper">
      <header class="article-header">
        <p class="kicker"><a href={`${base}neat-things`}>Neat things</a></p>
        <h1>{item.data.title}</h1>
        {item.data.description && <p class="article-description">{item.data.description}</p>}
        <Metadata date={item.data.date} tags={item.data.tags} />
      </header>

      {item.data.image && (
        <figure class="exhibit">
          <img
            src={item.data.image}
            alt={item.data.imageAlt || item.data.title}
          />
          {item.data.sourceUrl && (
            <figcaption>
              {item.data.sourceLabel ? (
                <>
                  Source:{' '}
                  <a href={item.data.sourceUrl} rel="noopener noreferrer">
                    {item.data.sourceLabel}
                  </a>
                </>
              ) : (
                <a href={item.data.sourceUrl} rel="noopener noreferrer">Source</a>
              )}
            </figcaption>
          )}
        </figure>
      )}

      <div class="article-content">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .page-content {
    padding: var(--space-lg) 0 var(--space-xl);
  }

  .article-container {
    min-height: calc(100vh - 56px - 180px);
    animation: fade-rise 0.7s ease both;
  }

  .kicker {
    font-size: 0.875rem;
    margin-bottom: var(--space-xs);
    color: var(--color-text-muted);
  }

  .article-header {
    margin-bottom: var(--space-lg);
  }

  .article-header h1 {
    margin-bottom: var(--space-sm);
  }

  .article-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    max-width: 38em;
  }

  .exhibit {
    margin: 0 0 var(--space-xl);
  }

  .exhibit img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: #fff;
  }

  .exhibit figcaption {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .article-content :global(p) {
    margin-bottom: 1rem;
    max-width: 40em;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--color-border);
    padding-left: var(--space-sm);
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-style: italic;
    font-size: 1.125rem;
    letter-spacing: -0.5px;
    max-width: 40em;
  }
</style>
