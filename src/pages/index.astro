---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const workItems = await getCollection('work');
const products = await getCollection('products');
const writing = await getCollection('writing');

const sortByDate = (a: any, b: any) => {
  const dateA = a.data.date || new Date(0);
  const dateB = b.data.date || new Date(0);
  return dateB.getTime() - dateA.getTime();
};

const featuredWork = workItems.sort(sortByDate).slice(0, 3);
const featuredProducts = products.slice(0, 2);
const recentWriting = writing.sort(sortByDate).slice(0, 3);

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<Layout
  title="Gerardo Ramirez"
  canonical={`${base}`}
>
  <Navigation />

  <main class="page-content" aria-label="Content">
    <div class="wrapper prose">
      <header class="intro-header">
        <h1 class="lede">
          I build the bridges that make complex technology work for people.
        </h1>
      </header>

      <div class="intro-body">
        <p>
          For more than 15 years, I've worked where technology meets the people who
          depend on it — turning complex requirements into integration paths that teams
          can deliver and developers actually want to use.
        </p>
        <p>
          That work has taken me across mobile SDKs, REST APIs, cloud platforms, and
          full-stack systems, in industries from enterprise hardware to telematics to
          financial technology. Along the way I've led engineering teams across three
          continents, built developer programs and technical education, partnered with
          product on long-term roadmaps, and mentored the people around me.
        </p>
        <p>
          I believe technology should strengthen relationships, not complicate them,
          and that the best solutions start with understanding people. Lately I've been
          exploring how AI agents change the way we build, and you'll see that throughout
          my writing and products.
        </p>
        <p>
          Start with my <a href={`${base}work`}>work</a>, see what I'm <a href={`${base}products`}>building</a>, or read
          what I'm <a href={`${base}writing`}>thinking about</a>. For the full story (roles, companies, and
          timeline), find me on <a href="https://www.linkedin.com/in/gerardo-ramirez-09/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
        </p>
        <div class="intro-buttons">
          <a href={`${base}work`} class="btn btn-primary">Explore my work</a>
          <a href="https://www.linkedin.com/in/gerardo-ramirez-09/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">View my LinkedIn</a>
        </div>
      </div>

      {featuredWork.length > 0 && (
        <section class="list-section">
          <h2>Selected work</h2>
          <ul class="plain-list">
            {featuredWork.map((item) => (
              <li>
                <a href={`${base}work/${item.slug}`} class="list-title">{item.data.title}</a>
                {item.data.description && <p>{item.data.description}</p>}
              </li>
            ))}
          </ul>
          <p class="more-link"><a href={`${base}work`}>View all work →</a></p>
        </section>
      )}

      {featuredProducts.length > 0 && (
        <section class="list-section">
          <h2>Products</h2>
          <ul class="plain-list">
            {featuredProducts.map((product) => (
              <li>
                <a
                  href={product.data.url || `${base}products/${product.slug}`}
                  class="list-title"
                >
                  {product.data.title}
                </a>
                {(product.data.description || product.data.tagline) && (
                  <p>{product.data.description || product.data.tagline}</p>
                )}
              </li>
            ))}
          </ul>
          <p class="more-link"><a href={`${base}products`}>View all products →</a></p>
        </section>
      )}

      {recentWriting.length > 0 && (
        <section class="list-section">
          <h2>Writing</h2>
          <ul class="plain-list">
            {recentWriting.map((article) => (
              <li>
                <a href={`${base}writing/${article.slug}`} class="list-title">{article.data.title}</a>
                {article.data.description && <p>{article.data.description}</p>}
              </li>
            ))}
          </ul>
          <p class="more-link"><a href={`${base}writing`}>View all writing →</a></p>
        </section>
      )}

      <section class="list-section">
        <h2>Speaking</h2>
        <p>
          I speak about what happens when people, products, and technology collide.
          See <a href={`${base}speaking`}>topics and speaker bio</a>.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page-content {
    padding: var(--space-lg) 0 var(--space-xl);
  }

  .prose {
    animation: fade-rise 0.7s ease both;
  }

  .intro-header {
    margin-bottom: var(--space-lg);
  }

  .lede {
    font-size: 2.25rem;
    letter-spacing: -1px;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: 0;
    max-width: 18em;
  }

  .intro-body {
    margin-bottom: var(--space-2xl);
    animation: fade-rise 0.8s ease 0.08s both;
  }

  .intro-body p {
    margin-bottom: 1rem;
    max-width: 40em;
  }

  .intro-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .intro-buttons .btn {
    text-decoration: none;
  }

  .list-section {
    margin-bottom: var(--space-2xl);
    animation: fade-rise 0.75s ease 0.14s both;
  }

  .list-section h2 {
    margin-bottom: var(--space-md);
    font-size: 1.75rem;
  }

  .plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .plain-list > li {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .plain-list > li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .list-title {
    display: inline-block;
    font-size: 1.35rem;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .list-title:visited {
    color: var(--color-text);
  }

  .list-title:hover {
    color: var(--color-accent);
  }

  .plain-list p {
    color: var(--color-text-muted);
    margin: 0;
    max-width: 40em;
  }

  .more-link {
    margin-top: var(--space-md);
  }

  @media (max-width: 800px) {
    .lede {
      font-size: 1.75rem;
    }

    .list-title {
      font-size: 1.2rem;
    }
  }
</style>
