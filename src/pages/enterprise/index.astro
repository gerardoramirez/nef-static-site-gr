---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

const baseUrl = import.meta.env.BASE_URL;
// Ensure baseUrl ends with a slash for proper URL construction
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<Layout>
  <Navigation />
  <div class="container">
    <header class="page-header">
      <h1>Enterprise AI</h1>
      <p class="subtitle">Documenting a journey from idea to AI-powered business</p>
    </header>

    <section class="intro">
      <p>This section is a living document of my journey building a business around AI. I'm sharing strategy, market research, product experiments, and the honest lessons along the way — no polished success story, just real progress in real time.</p>
    </section>

    <div class="sections-grid">
      <a href={`${base}enterprise/journey`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
        </div>
        <h2>The Journey</h2>
        <p>Why I'm doing this and where I'm starting from</p>
      </a>

      <a href={`${base}enterprise/strategy`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
        <h2>Business Strategy</h2>
        <p>Positioning, niches, and go-to-market thinking</p>
      </a>

      <a href={`${base}enterprise/market`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <h2>Market Research</h2>
        <p>Who's buying AI solutions and what they actually need</p>
      </a>

      <a href={`${base}enterprise/products`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <h2>Products & Experiments</h2>
        <p>What I'm building, testing, and learning from</p>
      </a>

      <a href={`${base}enterprise/lessons`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
        </div>
        <h2>Lessons Learned</h2>
        <p>What's working, what isn't, and what I'd do differently</p>
      </a>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 1rem;
  }

  .subtitle {
    font-size: 1.25rem;
    color: #6b7280;
    margin: 0;
  }

  .intro {
    max-width: 800px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .intro p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #4b5563;
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .section-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 2rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    border-color: #10b981;
  }

  .icon {
    color: #10b981;
    margin-bottom: 1.5rem;
  }

  .section-card h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 0.75rem;
  }

  .section-card p {
    color: #6b7280;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .container {
      padding: 2rem 1rem;
    }

    h1 {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .sections-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
