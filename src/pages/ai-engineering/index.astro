---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

const baseUrl = import.meta.env.BASE_URL;
// Ensure baseUrl ends with a slash for proper URL construction
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<Layout>
  <Navigation />
  <div class="container">
    <header class="page-header">
      <h1>AI Engineering</h1>
      <p class="subtitle">Exploring the intersection of artificial intelligence and software engineering</p>
    </header>

    <section class="intro">
      <p>Welcome to my AI Engineering hub. Here I share insights, projects, and tutorials based on my hands-on experience building AI-powered applications and systems.</p>
    </section>

    <div class="sections-grid">
      <a href={`${base}ai-engineering/projects`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <h2>Projects</h2>
        <p>Real-world AI projects and implementations</p>
      </a>

      <a href={`${base}ai-engineering/tutorials`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
        </div>
        <h2>Tutorials</h2>
        <p>Step-by-step guides and learning resources</p>
      </a>

      <a href={`${base}ai-engineering/insights`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 16v-4"></path>
            <path d="M12 8h.01"></path>
          </svg>
        </div>
        <h2>Insights</h2>
        <p>Thoughts and reflections on AI engineering</p>
      </a>

      <a href={`${base}ai-engineering/prompt-engineering`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
        </div>
        <h2>Prompt Engineering</h2>
        <p>Techniques and examples for crafting effective AI prompts</p>
      </a>

      <a href={`${base}ai-engineering/mcp-server`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
            <line x1="6" y1="6" x2="6.01" y2="6"></line>
            <line x1="6" y1="18" x2="6.01" y2="18"></line>
            <line x1="12" y1="6" x2="12" y2="6.01"></line>
            <line x1="12" y1="18" x2="12" y2="18.01"></line>
          </svg>
        </div>
        <h2>MCP Server</h2>
        <p>Model Context Protocol servers and integrations</p>
      </a>

      <a href={`${base}ai-engineering/rag`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
        </div>
        <h2>RAG</h2>
        <p>Retrieval-Augmented Generation for AI applications</p>
      </a>

      <a href={`${base}ai-engineering/agent`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v4"></path>
            <path d="M12 18v4"></path>
            <path d="M4.93 4.93l2.83 2.83"></path>
            <path d="M16.24 16.24l2.83 2.83"></path>
            <path d="M2 12h4"></path>
            <path d="M18 12h4"></path>
            <path d="M4.93 19.07l2.83-2.83"></path>
            <path d="M16.24 7.76l2.83-2.83"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </div>
        <h2>Agent</h2>
        <p>Autonomous AI agents and agentic workflows</p>
      </a>

      <a href={`${base}ai-engineering/cursor`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 3l4 9 5-7 5 15-9-4-4 4-6-17z"></path>
          </svg>
        </div>
        <h2>Cursor</h2>
        <p>AI-powered code editor and development workflows</p>
      </a>

      <a href={`${base}ai-engineering/codex`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <h2>CodeX</h2>
        <p>Codex skills and AI coding assistant capabilities</p>
      </a>

      <a href={`${base}ai-engineering/claude-code`} class="section-card">
        <div class="icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <h2>Claude Code</h2>
        <p>Claude Code and Anthropic's AI coding tools</p>
      </a>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 1rem;
  }

  .subtitle {
    font-size: 1.25rem;
    color: #6b7280;
    margin: 0;
  }

  .intro {
    max-width: 800px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .intro p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #4b5563;
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .section-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 2rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    border-color: #3b82f6;
  }

  .icon {
    color: #3b82f6;
    margin-bottom: 1.5rem;
  }

  .section-card h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 0.75rem;
  }

  .section-card p {
    color: #6b7280;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .container {
      padding: 2rem 1rem;
    }

    h1 {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .sections-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
